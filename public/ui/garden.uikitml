<style>
 .garden-panel { width: 62; background-color: #163438; border-color: #64877b; border-width: .08; border-radius: 2; padding-left: 2; padding-right: 2; padding-top: 1.5; padding-bottom: 1.5; flex-direction: column; gap: .8; }
 .title { color: #e7d9ae; font-size: 2; font-weight: 600; }
 .status { color: #c4d8c9; font-size: 1.55; line-height: 1.2; }
 .row { flex-direction: row; gap: 1; align-items: center; }
 .section { flex-direction: column; gap: 1; padding-top: 1; }
 .control { height: 4.6; min-width: 0; width: 10; font-size: 1.65; line-height: 1.2; gap: 0; flex-shrink: 0; background-color: #294b4c; border-radius: 1; padding-left: 1; padding-right: 1; padding-top: .5; padding-bottom: .5; color: #e3e8d3; }
 .primary { background-color: #dfc385; color: #1b3832; }
</style>
<div id="PanelRoot" class="garden-panel">
 <div class="row"><div class="title">BLOOM IN TIME</div><div id="ArrivalStatus" class="status">A: 3 beats / B: 4 beats</div></div>
 <div id="GardenStatus" class="status">Make both flowers bloom together.</div>
 <div class="row">
  <Button id="Btn_Play" class="control primary" style="width: 12"><ButtonLabel id="Btn_PlayLabel">Play</ButtonLabel></Button>
  <Button id="Btn_Undo" class="control" style="width: 9"><ButtonLabel>Undo</ButtonLabel></Button>
  <Button id="Btn_Hint" class="control" style="width: 9"><ButtonLabel>Hint</ButtonLabel></Button>
  <Button id="Btn_Tools" class="control" style="width: 11"><ButtonLabel id="Btn_ToolsLabel">Tools</ButtonLabel></Button>
  <Button id="Btn_Exit" class="control" style="width: 9"><ButtonLabel>Exit VR</ButtonLabel></Button>
 </div>
 <div id="BuildTools" class="section" style="display: none">
  <div class="row">
   <Button id="Btn_Bend" class="control" style="width: 12"><ButtonLabel>Bend</ButtonLabel></Button>
   <Button id="Btn_Delay" class="control" style="width: 14"><ButtonLabel>Delay pod</ButtonLabel></Button>
   <Button id="Btn_Place" class="control" style="width: 16"><ButtonLabel>Place</ButtonLabel></Button>
   <Button id="Btn_Return" class="control" style="width: 12"><ButtonLabel>Return</ButtonLabel></Button>
  </div>
  <div class="row">
   <Button id="Btn_Turn" class="control" style="width: 11"><ButtonLabel>Turn</ButtonLabel></Button>
   <Button id="Btn_ViewLeft" class="control" style="width: 11"><ButtonLabel>View left</ButtonLabel></Button>
   <Button id="Btn_ViewRight" class="control" style="width: 12"><ButtonLabel>View right</ButtonLabel></Button>
   <Button id="Btn_Settings" class="control" style="width: 16"><ButtonLabel>Settings</ButtonLabel></Button>
  </div>
 </div>
 <div id="ComfortTools" class="section" style="display: none">
  <div class="row">
   <Button id="Btn_Mute" class="control" style="width: 13"><ButtonLabel id="Btn_MuteLabel">Sound on</ButtonLabel></Button>
   <Button id="Btn_Motion" class="control" style="width: 16"><ButtonLabel id="Btn_MotionLabel">Motion on</ButtonLabel></Button>
   <Button id="Btn_Contrast" class="control" style="width: 13"><ButtonLabel>Contrast</ButtonLabel></Button>
   <Button id="Btn_Recenter" class="control" style="width: 12"><ButtonLabel>Recenter</ButtonLabel></Button>
  </div>
  <div class="row">
   <Button id="Btn_Near" class="control"><ButtonLabel>Nearer</ButtonLabel></Button>
   <Button id="Btn_Far" class="control"><ButtonLabel>Farther</ButtonLabel></Button>
   <Button id="Btn_Lower" class="control"><ButtonLabel>Lower</ButtonLabel></Button>
   <Button id="Btn_Higher" class="control"><ButtonLabel>Higher</ButtonLabel></Button>
   <Button id="Btn_Reset" class="control"><ButtonLabel id="Btn_ResetLabel">Reset</ButtonLabel></Button>
  </div>
  <Button id="Btn_ConfirmReset" class="control primary" style="display: none; width: 20"><ButtonLabel>Confirm reset</ButtonLabel></Button>
 </div>
 <Button id="Btn_XR" class="control" style="display: none; width: 16"><ButtonLabel>Enter VR</ButtonLabel></Button>
</div>
